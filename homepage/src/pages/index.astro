---
import MarketingLayout from "@/layouts/MarketingLayout.astro";
import SiteHeader from "@/components/marketing/SiteHeader.astro";
import HeroSection from "@/components/marketing/HeroSection.astro";
import DownloadButton from "@/components/marketing/DownloadButton.astro";
import FeatureSection from "@/components/marketing/FeatureSection.astro";
import SectionCopy from "@/components/marketing/SectionCopy.astro";
import JoinCallPreview from "@/components/marketing/JoinCallPreview.astro";
import ConferenceKindPreview from "@/components/marketing/ConferenceKindPreview.astro";
import QuickActionsPreview from "@/components/marketing/QuickActionsPreview.astro";
import AccountLinksPreview from "@/components/marketing/AccountLinksPreview.astro";
import DaysAheadPreview from "@/components/marketing/DaysAheadPreview.astro";
import CallistoMark from "@/components/brand/CallistoMark.astro";
import jupiterVideo from "@/assets/jupiter.mp4";
---

<MarketingLayout>
  <Fragment slot="fixed-background">
    <video
      class="pointer-events-none object-cover opacity-75 jupiter"
      src={jupiterVideo}
      autoplay
      muted
      loop
      playsinline></video>
  </Fragment>

  <Fragment slot="hero">
    <!-- Hero -->
    <section class="relative mx-auto w-full max-w-360">
      <SiteHeader />
      <HeroSection>
        <Fragment slot="copy">
          <div>
            <h1
              class="mb-8 font-sans text-[2.15rem] font-medium leading-[1.12] tracking-[-0.045em] text-light sm:text-[2.7rem] md:text-[3.55rem] lg:text-[3.75rem]"
            >
              <span>Menu Bar Calendar</span><br />
              <span class="text-primary">optimized for meetings</span>
            </h1>
            <p class="max-w-98 text-base leading-7 text-light/72">
              Callisto gives you direct access to all your meetings in the most
              convenient way.
            </p>
          </div>
        </Fragment>

        <Fragment slot="actions">
          <DownloadButton class="rounded-sm px-6 shadow-elevation-2" />
          <a
            href="#features"
            class="group inline-flex items-center gap-3 text-sm font-medium text-light/90 transition-colors duration-hover hover:text-primary"
          >
            <span>Learn more</span>
            <svg
              xmlns="http://www.w3.org/2000/svg"
              class="size-4 transition-transform duration-hover group-hover:translate-y-0.5"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
              aria-hidden="true"
              ><polyline points="6 9 12 15 18 9"></polyline></svg
            >
          </a>
        </Fragment>
      </HeroSection>
    </section>
  </Fragment>

  <!-- Features -->
  <div id="features" class="flex flex-col gap-3 relative z-50">
    <!-- Click to join -->
    <FeatureSection
      gradientClass="inset-0 bg-[radial-gradient(circle_at_85%_50%,rgba(255,176,138,0.08),transparent_30%)]"
    >
      <SectionCopy
        slot="copy"
        eyebrow="One click"
        heading="Click the event,<br />you are in the call"
        description="Callisto pulls the Zoom or Meet link out of the invite and opens it. No conference link on the event? The click opens it in Google Calendar instead."
      />

      <JoinCallPreview slot="visual" />
    </FeatureSection>

    <!-- Zoom vs Meet -->
    <FeatureSection
      surface="muted"
      gradientClass="inset-y-0 right-0 w-1/2 bg-[radial-gradient(circle_at_52%_50%,rgba(255,176,138,0.08),transparent_42%)]"
    >
      <SectionCopy
        slot="copy"
        eyebrow="Zoom or Meet"
        heading="Know which call<br />before you click"
        description="Every event carrying a conference link says which kind it is right on the row — zoom, meet, or a plain video mark for anything else — so you know what is about to open."
      />

      <ConferenceKindPreview slot="visual" />
    </FeatureSection>

    <!-- Right-click quick actions -->
    <FeatureSection
      id="design"
      gradientClass="inset-0 bg-[radial-gradient(circle_at_70%_45%,rgba(43,43,61,0.32),transparent_35%)]"
    >
      <SectionCopy
        slot="copy"
        eyebrow="Quick actions"
        heading="Right-click for<br />everything else"
        description="Accept, maybe or decline. Copy an attendee's address. Open in Calendar, or delete. On a recurring event, pick this one or this and every one after it."
      />

      <QuickActionsPreview slot="visual" />
    </FeatureSection>

    <!-- Multiple accounts / authuser -->
    <FeatureSection
      surface="muted"
      gradientClass="inset-y-0 right-0 w-1/2 bg-[radial-gradient(circle_at_50%_45%,rgba(255,176,138,0.07),transparent_40%)]"
    >
      <SectionCopy
        slot="copy"
        eyebrow="Multiple accounts"
        heading="Links open as the<br />right you"
        description="Set the Google profile index for each connected account. Callisto stamps it on every calendar and meeting link, so you land in the call instead of an account picker."
      />

      <AccountLinksPreview slot="visual" />
    </FeatureSection>

    <!-- Days ahead -->
    <FeatureSection
      gradientClass="inset-0 bg-[radial-gradient(circle_at_78%_50%,rgba(255,176,138,0.07),transparent_32%)]"
    >
      <SectionCopy
        slot="copy"
        eyebrow="Your horizon"
        heading="See as far ahead<br />as you need"
        description="The next day, the next week, the next month — you choose how much of the schedule the panel shows, and it stays that short."
      />

      <DaysAheadPreview slot="visual" />
    </FeatureSection>
  </div>

  <!-- Footer -->
  <footer
    id="pricing"
    aria-labelledby="footer-heading"
    class="relative mt-16 mb-24 overflow-hidden rounded-lg border border-primary/10 bg-surface/55 shadow-elevation-2 ring-1 ring-foreground/[0.035]"
  >
    <div
      class="absolute inset-0 bg-[radial-gradient(circle_at_12%_50%,rgba(255,176,138,0.12),transparent_28%),radial-gradient(circle_at_86%_50%,rgba(255,176,138,0.08),transparent_30%)]"
    >
    </div>
    <div
      class="relative grid items-center gap-8 px-8 py-8 text-center md:grid-cols-[72px_minmax(0,1fr)_minmax(240px,auto)] md:px-16 md:text-left lg:px-[88px]"
    >
      <div class="flex justify-center md:justify-start">
        <CallistoMark size="lg" class="size-16" />
      </div>

      <div>
        <h2
          id="footer-heading"
          class="font-sans text-2xl font-medium tracking-[-0.03em] text-light md:text-3xl"
        >
          Ready to stop hunting for meeting links?
        </h2>
        <p class="mt-2 max-w-[500px] text-base leading-6 text-light/66">
          Download Callisto for macOS and keep every call one click from the
          menu bar.
        </p>
      </div>

      <div class="md:justify-self-end">
        <DownloadButton
          class="w-full min-w-[240px] rounded-sm px-8 shadow-elevation-2 md:w-auto"
        />
        <p class="mt-3 text-xs text-light/48">macOS 14.0 or later</p>
      </div>
    </div>
    <div
      class="relative flex flex-col gap-3 border-t border-light/10 px-8 py-5 text-center text-sm text-light/52 md:flex-row md:items-center md:justify-between md:px-16 md:text-left lg:px-[88px]"
    >
      <p>Callisto for macOS</p>
      <div class="flex justify-center gap-5">
        <a
          href="/privacy/"
          class="transition-colors duration-hover hover:text-primary"
        >
          Privacy Policy
        </a>
        <a
          href="/terms/"
          class="transition-colors duration-hover hover:text-primary"
        >
          Terms
        </a>
      </div>
    </div>
  </footer>
</MarketingLayout>
