---
import callistoLogo from "@/assets/callisto-logo.png";

interface Props {
  class?: string;
}

const { class: className } = Astro.props;
---

<a
  href="#"
  class:list={["flex items-center gap-4", className]}
  aria-label="Callisto Homepage"
>
  <img
    src={callistoLogo.src}
    alt="Callisto"
    width="40"
    height="40"
    class="size-10"
  />
  <span class="text-base font-medium uppercase tracking-[0.45em] text-light"
    >Callisto</span
  >
</a>
