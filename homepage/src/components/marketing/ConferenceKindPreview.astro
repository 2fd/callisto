---
import { Video } from "@lucide/astro";
import AppPanel from "@/components/marketing/AppPanel.astro";
import AppDayHeader from "@/components/marketing/AppDayHeader.astro";
import AppEventRow from "@/components/marketing/AppEventRow.astro";
import { eventPalette } from "@/lib/calendarRow";
---

<div class="flex w-full flex-col items-start gap-3 md:items-end">
  <AppPanel month="AUG 2026">
    <AppDayHeader day="TUE 11" />

    <AppEventRow title="Customer call" time="13:00 - 14:00" conference="zoom" />

    <AppEventRow
      title="Sprint planning"
      time="14:30 - 15:00"
      color={eventPalette.sage}
      conference="meet"
    />

    <AppEventRow
      title="Vendor sync"
      time="15:30 - 16:00"
      color={eventPalette.grape}
      conference="other"
    />
  </AppPanel>

  <div class="flex w-[320px] max-w-full flex-col gap-1.5 text-xs text-light/60">
    <span class="flex items-center gap-2">
      <span class="w-9 shrink-0"
        ><Video class="size-3.5 fill-current text-[#2d8cff]" /></span
      >
      A Zoom link
    </span>
    <span class="flex items-center gap-2">
      <span class="w-9 shrink-0"
        ><Video class="size-3.5 fill-current text-[#fed812]" /></span
      >
      A Google Meet link
    </span>
    <span class="flex items-center gap-2">
      <span class="flex w-9 shrink-0">
        <Video class="size-3.5 fill-current text-[#34a853]" />
      </span>
      Any other video link
    </span>
  </div>
</div>
