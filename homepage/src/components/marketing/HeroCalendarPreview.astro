---
interface CalendarEvent {
  time: string;
  title: string;
  subtitle: string;
  color?: string;
  active?: boolean;
}

interface Props {
  events?: CalendarEvent[];
  class?: string;
}

const defaultEvents: CalendarEvent[] = [
  {
    time: "9 AM",
    title: "Team Standup",
    subtitle: "9:00 – 9:30 AM",
    color: "bg-primary",
  },
  {
    time: "10 AM",
    title: "Design Review",
    subtitle: "10:00 – 11:00 AM",
    color: "bg-[#c6a4d9]",
  },
  {
    time: "11 AM",
    title: "Client Call",
    subtitle: "11:30 AM – 12:30 PM",
    color: "bg-light/70",
    active: true,
  },
  {
    time: "1 PM",
    title: "Focus Time",
    subtitle: "1:30 – 3:00 PM",
    color: "bg-[#9b94c9]",
  },
];

const { events = defaultEvents, class: className } = Astro.props;
---

<div class:list={["relative mr-0 w-full max-w-[336px]", className]}>
  <div
    class="overflow-hidden rounded-md border border-primary/16 bg-night/80 shadow-[0_28px_90px_rgba(0,0,0,0.42)] backdrop-blur-xl"
  >
    <div class="flex items-center gap-2 px-5 pt-4">
      <span class="size-3 rounded-full bg-[#ff7d62]"></span>
      <span class="size-3 rounded-full bg-[#ffbd6f]"></span>
      <span class="size-3 rounded-full bg-[#66c878]"></span>
    </div>

    <div class="px-5 pb-5 pt-7">
      <div class="mb-5 flex items-baseline gap-5">
        <span class="text-2xl font-semibold text-primary">Today</span>
        <span class="text-sm text-light/58">Monday, June 24</span>
      </div>

      <div class="grid grid-cols-[44px_minmax(0,1fr)] gap-x-4 gap-y-3">
        {
          events.map((event) => (
            <>
              <div
                class:list={[
                  "text-xs text-light/54",
                  event.active ? "pt-3" : "pt-1",
                ]}
              >
                {event.time}
              </div>
              {event.active ? (
                <div class="rounded-sm bg-primary p-3 text-primary-foreground shadow-[0_10px_28px_rgba(255,176,138,0.24)]">
                  <div class="flex items-center gap-2 text-sm font-semibold">
                    <span class:list={["size-2 rounded-full", event.color]} />
                    {event.title}
                  </div>
                  <p class="mt-1 pl-4 text-xs text-night/78">
                    {event.subtitle}
                  </p>
                </div>
              ) : (
                <div class="rounded-sm bg-light/[0.09] p-3 ring-1 ring-foreground/[0.05]">
                  <div class="flex items-center gap-2 text-sm font-medium text-light">
                    <span class:list={["size-2 rounded-full", event.color]} />
                    {event.title}
                  </div>
                  <p class="mt-1 pl-4 text-xs text-light/58">
                    {event.subtitle}
                  </p>
                </div>
              )}
            </>
          ))
        }
        <div class="text-xs text-light/54">2 PM</div>
        <div></div>
        <div class="text-xs text-light/54">3 PM</div>
        <div></div>
      </div>
    </div>
  </div>
</div>
