---
interface Props {
  class?: string;
}

const { class: className } = Astro.props;

// The visual column reserves a lot of vertical space. Render it only when it is
// actually filled, otherwise the hero collapses to dead space on small screens.
const hasVisual = Astro.slots.has("visual");
---

<div
  class:list={[
    // Horizontal padding tracks SiteHeader so the headline lines up with the
    // logo instead of running into the viewport edge.
    "relative z-10 grid w-full items-center gap-12 px-5 pb-16 pt-8 sm:px-6 md:px-8 md:pb-16 md:pt-12 lg:h-225 lg:pb-12 lg:pt-10",
    hasVisual && "lg:grid-cols-[minmax(0,1fr)_460px]",
    className,
  ]}
>
  <slot name="background" />
  <div class="w-full space-y-8">
    <div class="space-y-6">
      <slot name="copy" />
    </div>
    <div class="flex flex-wrap items-center gap-8">
      <slot name="actions" />
    </div>
  </div>
  {
    hasVisual && (
      <div class="relative mx-auto flex min-h-[350px] w-full max-w-[460px] items-center justify-center lg:justify-end">
        <slot name="visual" />
      </div>
    )
  }
</div>
