---
import Button from "@/components/ui/Button.astro";

interface Props {
  size?:
    | "default"
    | "sm"
    | "lg"
    | "xs"
    | "icon"
    | "icon-xs"
    | "icon-sm"
    | "icon-lg";
  class?: string;
  variant?:
    | "default"
    | "outline"
    | "secondary"
    | "ghost"
    | "destructive"
    | "link";
}

const { size = "lg", class: className, variant = "default" } = Astro.props;
---

<Button size={size} class={className} variant={variant}>
  <span>Download for macOS</span>
  <svg
    xmlns="http://www.w3.org/2000/svg"
    class="size-4"
    viewBox="0 0 24 24"
    fill="none"
    stroke="currentColor"
    stroke-width="2"
    stroke-linecap="round"
    stroke-linejoin="round"
    aria-hidden="true"
  >
    <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path>
    <polyline points="7 10 12 15 17 10"></polyline>
    <line x1="12" x2="12" y1="15" y2="3"></line>
  </svg>
</Button>
