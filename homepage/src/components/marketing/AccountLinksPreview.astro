---
const accounts = [
  { email: "me@work.com", authuser: 0 },
  { email: "me@side.co", authuser: 1 },
  { email: "me@gmail.com", authuser: 2 },
];
---

<div class="w-full max-w-[360px] space-y-2 lg:max-w-none">
  {
    accounts.map((account) => (
      <div class="rounded-sm bg-light/[0.07] p-3 shadow-elevation-1 ring-1 ring-foreground/[0.07]">
        <div class="flex items-center justify-between gap-4">
          <p class="truncate text-sm font-medium text-light">{account.email}</p>
          <div class="flex shrink-0 items-center gap-2">
            <span class="text-xs text-light/52">Authuser</span>
            <div class="flex items-center overflow-hidden rounded-xs ring-1 ring-foreground/12">
              <span class="px-1.5 py-0.5 text-xs text-light/45">−</span>
              <span class="bg-light/[0.06] px-2 py-0.5 text-xs font-semibold text-light">
                {account.authuser}
              </span>
              <span class="px-1.5 py-0.5 text-xs text-light/45">+</span>
            </div>
          </div>
        </div>
        <p class="mt-2 truncate font-mono text-[0.68rem] text-light/45">
          meet.google.com/…?
          <span class="text-primary">authuser={account.authuser}</span>
        </p>
      </div>
    ))
  }
</div>
