---
interface Props {
  id?: string;
  class?: string;
  surface?: "default" | "muted";
  gradientClass?: string;
}

const {
  id,
  class: className,
  surface = "default",
  gradientClass,
} = Astro.props;

const surfaceClass = surface === "muted" ? "bg-surface/45" : "bg-surface/55";
---

<section
  id={id}
  class:list={[
    "relative overflow-hidden rounded-lg shadow-elevation-2 ring-1 ring-foreground/[0.035]",
    surfaceClass,
    className,
  ]}
>
  {gradientClass && <div class:list={["absolute", gradientClass]} />}
  <div
    class="relative grid min-h-[220px] items-center gap-8 px-8 py-9 md:px-16 lg:grid-cols-[112px_minmax(0,330px)_1fr] lg:gap-8 lg:px-[88px]"
  >
    <slot name="icon" />
    <slot name="copy" />
    <slot name="visual" />
  </div>
</section>
