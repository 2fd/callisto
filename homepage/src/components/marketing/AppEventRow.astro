---
/** Matches EventRow: neutral surface, calendar rail, and semantic time-off fill. */
import {
  CircleMinus,
  Gift,
  MapPin,
  TriangleAlert,
  UserRoundX,
  Video,
} from "@lucide/astro";
import { rowStyle, type RowTreatment } from "@/lib/calendarRow";

export type ConferenceKind = "zoom" | "meet" | "other";

/**
 * The badges an event can earn, declared in the order `EventBadge.all` lays
 * them out — key order is what the row iterates.
 */
const badgeIcons = {
  outOfOffice: { icon: CircleMinus, help: "out of office" },
  birthday: { icon: Gift, help: "birthday" },
  important: { icon: TriangleAlert, help: "important" },
  allDeclined: { icon: UserRoundX, help: "all attendees declined" },
} as const;

export type BadgeKind = keyof typeof badgeIcons;

interface Props {
  title: string;
  /** The event's hours, e.g. "11:00 - 12:00". Omitted on an all-day row. */
  time?: string;
  /** The event's color, untoned — a Google palette value. */
  color?: string;
  treatment?: RowTreatment;
  outOfOffice?: boolean;
  /** Tentative: diagonal stripes over the fill. */
  tentative?: boolean;
  /** Declined or cancelled: the title and hours are struck through. */
  struckThrough?: boolean;
  past?: boolean;
  /** All-day and out-of-office rows say everything on one line. */
  compact?: boolean;
  /** A timed out-of-office row carries its hours in the header instead. */
  inlineTime?: boolean;
  location?: string;
  conference?: ConferenceKind;
  badges?: BadgeKind[];
  /** Renders the row as hovered — the state the pointer is on. */
  hover?: boolean;
  class?: string;
}

const {
  title,
  time,
  color,
  treatment = "filled",
  outOfOffice = false,
  tentative = false,
  struckThrough = false,
  past = false,
  compact = false,
  inlineTime = false,
  location,
  conference,
  badges = [],
  hover = false,
  class: className,
} = Astro.props;

const style = rowStyle({ color, treatment, tentative, struckThrough, past });

const shownBadges = (Object.keys(badgeIcons) as BadgeKind[]).filter((badge) =>
  badges.includes(badge),
);

const timeOff = outOfOffice || badges.includes("outOfOffice");
const surface = timeOff
  ? "rgb(255 59 48 / 0.18)"
  : treatment === "ongoing"
    ? `rgb(${style.tint} / 0.14)`
    : "rgb(255 255 255 / 0.025)";
const stripes = `repeating-linear-gradient(135deg, rgb(${style.tint} / 0.08) 0 6px, transparent 6px 18px)`;
---

<div
  class:list={["relative overflow-hidden rounded-[8px]", className]}
  style={`opacity:${style.contentOpacity};background:${surface}`}
>
  {
    !timeOff && (
      <div
        class="absolute inset-y-0.5 left-0 w-[3px] rounded-[1.5px]"
        style={`background:rgb(${style.tint})`}
      />
    )
  }
  {
    treatment === "bordered" && (
      <div
        class="absolute inset-0 rounded-[8px] border-[0.5px]"
        style={`border-color:rgb(${style.tint} / 0.35)`}
      />
    )
  }
  {
    style.isStriped && (
      <div class="absolute inset-0" style={`background:${stripes}`} />
    )
  }
  {hover && <div class="absolute inset-0 bg-white/[0.06]" />}
  <div class="relative flex flex-col gap-0.5 px-3 py-1.5">
    <div class="flex items-center gap-2">
      <span
        class:list={[
          "min-w-0 flex-1 truncate text-[13px] leading-4",
          style.isStruckThrough && "line-through",
        ]}
        style={`color:${style.title};font-weight:${style.titleWeight}`}
      >
        {title}
      </span>

      {
        inlineTime && time && (
          <span
            class:list={[
              "shrink-0 text-[11px] leading-[13px]",
              style.isStruckThrough && "line-through",
            ]}
            style={`color:${style.detail}`}
          >
            {time}
          </span>
        )
      }

      {
        shownBadges.map((badge) => {
          const Badge = badgeIcons[badge].icon;
          return (
            <Badge
              class="size-3 shrink-0"
              title={badgeIcons[badge].help}
              style={
                badge === "important"
                  ? "color:#FFD60A"
                  : `color:${style.detail}`
              }
            />
          );
        })
      }
    </div>

    {
      !compact && (
        <div class="flex items-center gap-2" style={`color:${style.detail}`}>
          <span
            class:list={[
              "flex-1 text-[11px] leading-[13px]",
              style.isStruckThrough && "line-through",
            ]}
          >
            {time}
          </span>

          {style.showsAccessories && location && (
            <MapPin class="size-2.5 shrink-0 opacity-70" title={location} />
          )}

          {style.showsAccessories && conference && (
            <Video
              class="size-3.5 shrink-0 fill-current"
              style={`color:${conference === "zoom" ? "#2d8cff" : conference === "meet" ? "#fed812" : "#34a853"}`}
              title={`Has ${conference === "other" ? "meeting" : conference} link`}
            />
          )}
        </div>
      )
    }
  </div>
</div>
