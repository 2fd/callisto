---
interface Props {
  class?: string;
}

const { class: className } = Astro.props;
---

<div class:list={["w-full max-w-[300px] space-y-3 lg:mr-16", className]}>
  <div
    class="rounded-sm bg-light/[0.08] p-4 shadow-elevation-1 ring-1 ring-foreground/[0.06]"
  >
    <p class="mb-4 text-sm font-medium text-light/88">Upcoming</p>
    <div class="flex items-center gap-4">
      <span class="size-3 rounded-full bg-[#d696c8]"></span>
      <div>
        <p class="text-sm font-medium text-light">Design Review</p>
        <p class="mt-1 text-sm text-light/56">in 10 min</p>
      </div>
    </div>
  </div>
  <div
    class="rounded-sm bg-light/[0.08] p-4 shadow-elevation-1 ring-1 ring-foreground/[0.06]"
  >
    <div class="flex items-center gap-4">
      <svg
        xmlns="http://www.w3.org/2000/svg"
        class="size-5 text-primary"
        viewBox="0 0 24 24"
        fill="currentColor"
        aria-hidden="true"
        ><path d="M13 2 3 14h8l-1 8 11-12h-8l1-8Z"></path></svg
      >
      <div>
        <p class="text-sm font-medium text-light">Focus Time</p>
        <p class="mt-1 text-sm text-light/56">Starts in 1h</p>
      </div>
    </div>
  </div>
</div>
