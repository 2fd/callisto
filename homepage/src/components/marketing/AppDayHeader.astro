---
/** Mirrors DaySectionHeader's quiet, sentence-case date label. */
interface Props {
  day: string;
}
const { day } = Astro.props;
const label = day.charAt(0).toUpperCase() + day.slice(1).toLowerCase();
---

<p
  class="px-1 pt-2 pb-1 text-[11px] leading-[13px] font-semibold text-[#ababab]"
>
  {label}
</p>
