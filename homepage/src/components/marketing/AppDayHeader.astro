---
/**
 * A day's heading inside the panel, as `DaySectionHeader` writes it: the
 * weekday and the date, uppercased.
 */
interface Props {
  /** The day, formatted "EEE dd" — e.g. "SAT 09". */
  day: string;
}

const { day } = Astro.props;
---

<p class="px-3 pt-2 pb-px text-[13px] leading-4 font-semibold text-light/55">
  {day}
</p>
