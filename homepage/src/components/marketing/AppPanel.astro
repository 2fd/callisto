---
/**
 * The menu bar panel itself, at the width the app draws it (`UI.Width`, 280pt)
 * and with the chrome `PopoverChrome`, `PopoverHeader` and `PopoverFooter` give
 * it: a translucent, rounded surface with the month on top and the last sync
 * underneath.
 */
import { RotateCcw, RotateCw, Settings } from "@lucide/astro";

interface Props {
  /** The header's title, as the app formats it: "MMM yyyy", uppercased. */
  month?: string;
  /** The footer's sync line. Omit it to leave the footer off. */
  synced?: string;
  class?: string;
}

const { month = "AUG 2026", synced, class: className } = Astro.props;
---

<div
  class:list={[
    "w-[280px] shrink-0 overflow-hidden rounded-[10px] bg-surface/70 shadow-elevation-3 ring-1 ring-light/[0.08] backdrop-blur-2xl",
    className,
  ]}
>
  <div class="flex items-center gap-2 px-3 pt-2 pb-1">
    <span class="text-[15px] leading-5 text-light">{month}</span>
    <span class="flex-1"></span>
    <RotateCcw class="size-3.5 text-light/85" title="Refresh" />
    <Settings class="size-3.5 text-light/85" title="Settings" />
  </div>

  <div class="flex flex-col gap-1 pt-2 pr-3 pb-5 pl-1">
    <slot />
  </div>

  {
    synced && (
      <div class="flex items-center px-3 pb-2 text-[10px] leading-3 text-light/55">
        <span class="flex-1">{synced}</span>
        <RotateCw class="size-2.5" title="Refresh" />
      </div>
    )
  }
</div>
