---
/** Mirrors the app's Standard panel, header, list insets, and footer. */
import { RotateCcw, Settings } from "@lucide/astro";

interface Props {
  month?: string;
  class?: string;
}
const { month = "Aug 2026", class: className } = Astro.props;
const monthLabel = month.charAt(0).toUpperCase() + month.slice(1).toLowerCase();
---

<div
  class:list={[
    "app-panel w-[320px] max-w-full shrink-0 overflow-hidden rounded-[16px] bg-[#1c1c1c]/95 text-[#f2f2f2] shadow-elevation-3 ring-1 ring-white/20 backdrop-blur-2xl",
    className,
  ]}
>
  <div class="mx-3 flex h-10 items-center gap-3 border-b border-white/10">
    <span class="text-[15px] leading-5 font-semibold">{monthLabel}</span>
    <span class="flex-1"></span>
    <span class="flex h-7 w-6 items-center justify-center"
      ><RotateCcw class="size-4 text-white/85" title="Refresh events" /></span
    >
    <span class="flex h-7 w-6 items-center justify-center"
      ><Settings class="size-4 text-white/85" title="Settings" /></span
    >
  </div>
  <div class="flex flex-col gap-1 px-3 pb-3">
    <slot />
  </div>
  <div
    class="mx-3 flex h-8 items-center justify-center border-t border-white/10 text-[12px] font-medium text-[#ababab]"
  >
    More events…
  </div>
</div>

<style>
  .app-panel {
    font-family:
      -apple-system, BlinkMacSystemFont, "Inter Variable", sans-serif;
  }
</style>
