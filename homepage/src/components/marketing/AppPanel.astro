---
interface Props {
  /** Optional day header, e.g. "Today". */
  heading?: string;
  class?: string;
}

const { heading, class: className } = Astro.props;
---

<div
  class:list={[
    "w-full rounded-sm bg-light/[0.07] p-2 shadow-elevation-2 ring-1 ring-foreground/[0.07]",
    className,
  ]}
>
  {
    heading && (
      <p class="px-2 pb-1.5 pt-1 text-[0.62rem] font-semibold uppercase tracking-[0.18em] text-light/50">
        {heading}
      </p>
    )
  }
  <slot />
</div>
