---
interface Props {
  class?: string;
}

const { class: className } = Astro.props;
---

<div
  class:list={[
    "relative flex size-[300px] items-center justify-center",
    className,
  ]}
>
  <div class="absolute size-[300px] rounded-full border border-primary/8"></div>
  <div class="absolute size-[236px] rounded-full border border-primary/13">
  </div>
  <div class="absolute size-[172px] rounded-full border border-primary/18">
  </div>
  <div class="absolute size-[108px] rounded-full border border-primary/28">
  </div>
  <div
    class="relative flex size-[96px] flex-col items-center justify-center rounded-full bg-primary text-center text-primary-foreground shadow-[0_16px_50px_rgba(255,176,138,0.24)]"
  >
    <svg
      xmlns="http://www.w3.org/2000/svg"
      class="size-7 text-night"
      viewBox="0 0 24 24"
      fill="currentColor"
      aria-hidden="true"
      ><path d="M13.7 2.7 4 14h7.2l-.9 7.3L20 10h-7.2l.9-7.3Z"></path></svg
    >
    <p class="mt-1 text-xs font-semibold leading-4">Focus Mode</p>
    <p class="text-xs font-semibold leading-4">25:00</p>
  </div>
</div>
